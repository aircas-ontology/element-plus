{
  "name": "@styles/element-plus-theme",
  "version": "1.0.0",
  "description": "Dark navy and cyan Element Plus theme based on the Styles design specification",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js" },
    "./theme.css": "./theme.css",
    "./tokens": { "types": "./tokens.d.ts", "import": "./tokens.js" },
    "./package.json": "./package.json"
  },
  "files": ["index.js", "index.d.ts", "theme.css", "tokens.js", "tokens.d.ts", "README.md"],
  "sideEffects": ["*.css", "index.js"],
  "peerDependencies": { "element-plus": "^2.14.7", "vue": "^3.5.0" }
}
